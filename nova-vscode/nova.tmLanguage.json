{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Nova",
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "include": "#sections"
    },
    {
      "include": "#keywords"
    },
    {
      "include": "#types"
    },
    {
      "include": "#strings"
    },
    {
      "include": "#numbers"
    },
    {
      "include": "#booleans"
    }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.nova",
          "match": "//.*$"
        }
      ]
    },
    "sections": {
      "patterns": [
        {
          "name": "entity.name.section.nova",
          "match": "\\b(Setup|Logic):"
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.nova",
          "match": "\\b(If|Else|Repeat|Always|Forever|When|Call|Include|Execute)\\b"
        },
        {
          "name": "keyword.other.nova",
          "match": "\\b(Target|Use|Component|on|Pin|as|into|times|distance|speed|status|pwm|ms|Interrupt)\\b"
        },
        {
          "name": "support.function.nova",
          "match": "\\b(Print|Read|ReadAnalog|Delay|Wait|Pause)\\b"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "storage.type.nova",
          "match": "\\b(Number|String|Array|Function|ESP32|STM32|Arduino)\\b"
        }
      ]
    },
    "booleans": {
      "patterns": [
        {
          "name": "constant.language.nova",
          "match": "\\b(High|Low|On|Off|True|False)\\b"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.nova",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.nova",
              "match": "\\\\."
            }
          ]
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.nova",
          "match": "\\b\\d+(\\.\\d+)?\\b"
        }
      ]
    }
  },
  "scopeName": "source.nova"
}